# Ministree connection — point this template deploy at one church.
# Leave blank to render the template's own defaults (no Ministree).

# Ministree public API base (a trailing /v1 is stripped automatically).
NEXT_PUBLIC_MINISTREE_API_URL=https://api.ministr.ee

# The church's org slug — this deploy serves exactly this church.
NEXT_PUBLIC_ORG_SLUG=

# Optional (Stage 2): which Customizer content blob to load.
# NEXT_PUBLIC_MINISTREE_TEMPLATE_ID=
