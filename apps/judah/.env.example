# Point this deploy at one church. Leave blank and the template renders its own
# demo conference, which is what it does before anyone connects it.
NEXT_PUBLIC_MINISTREE_API_URL=https://api.ministr.ee
NEXT_PUBLIC_ORG_SLUG=

# Only exists after you connect the deploy in the Ministree admin
# (Templates -> Connect your template). Add it, redeploy, and the church's
# Customizer edits start flowing through.
# NEXT_PUBLIC_MINISTREE_TEMPLATE_ID=
